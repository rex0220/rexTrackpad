    "(not installed)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "（未インストール）"
          }
        }
      }
    },
    "About rexTrackpad": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "rexTrackpad について"
          }
        }
      }
    },
    "Accessibility": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティ"
          }
        }
      }
    },
    "Accessibility Permission Needed…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティの許可が必要…"
          }
        }
      }
    },
    "After rebuilding the app, macOS may treat it as a new app. If gestures stop working, remove rexTrackpad from the Accessibility list and add it again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリをビルドし直すと、macOS が別のアプリとして扱うことがあります。ジェスチャーが効かなくなったら、アクセシビリティの一覧から rexTrackpad を削除して追加し直してください。"
          }
        }
      }
    },
    "Also used by macOS": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS と重複"
          }
        }
      }
    },
    "App Exposé": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Exposé"
          }
        }
      }
    },
    "Assignments": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "割り当て"
          }
        }
      }
    },
    "Avoid macOS gesture conflicts": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS のジェスチャーと競合させない"
          }
