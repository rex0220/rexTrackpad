{
  "sourceLanguage": "en",
  "strings": {
    "%@ · %llu frames received": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · 受信フレーム数 %2$llu"
          }
        }
      }
    },
    "%lld": {
      "shouldTranslate": false
    },
    "%lld-Finger Circle (%@)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld本指で円（%2$@）"
          }
        }
      }
    },
    "%lld-Finger Swipe %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld本指スワイプ（%2$@）"
          }
        }
      }
    },
    "%lld-Finger Tap": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld本指タップ"
          }
        }
      }
    },
    "%lld-Finger Tap (%@)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld本指タップ（%2$@）"
