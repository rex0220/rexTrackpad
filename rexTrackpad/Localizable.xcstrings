    "rexTrackpad does not request this. Grant it only if Trackpad Input below stays at 0 frames while you touch the trackpad.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "rexTrackpad はこの権限を要求しません。トラックパッドに触れても下の「トラックパッド入力」が 0 フレームのままの場合にだけ許可してください。"
          }
        }
      }
    },
