// Code signing for rexTrackpad and its unit tests.
//
// Default: ad-hoc signing ("Sign to Run Locally"), so anyone can clone and build
// without an Apple developer account.
//
// Ad-hoc signatures change with every build, and macOS then treats the app as a
// new app and drops its Accessibility permission. To keep the permission across
// rebuilds, sign with your own Apple Development certificate:
//
//     cp Config/Signing.local.xcconfig.example Config/Signing.local.xcconfig
//
// and put your Team ID in it. Signing.local.xcconfig is git-ignored.

CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
